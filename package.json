{
  "name": "@open-wxa/wxa-runner",
  "version": "0.4.0",
  "description": "Run WeChat Mini Programs in the browser on the official base library, for debugging and E2E testing",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter wxa-runner dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "weapp",
    "runtime",
    "e2e",
    "testing"
  ],
  "author": "open-wxa",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@open-wxa/wxa-runner-playwright": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "^8.54.0",
    "express": "^4.18.2",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "prettier": "^3.1.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^1.0.4",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-wxa/wxa-runner.git"
  },
  "homepage": "https://open-wxa.github.io/wxa-runner/",
  "bugs": {
    "url": "https://github.com/open-wxa/wxa-runner/issues"
  }
}
