{
  "name": "@open-wxa/wxa-viewer",
  "version": "0.10.0",
  "private": true,
  "description": "Run WeChat Mini Programs from a prebuilt .wxapack in the browser, without the source or a dev server",
  "license": "MIT",
  "author": "open-wxa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-wxa/wxa-runner.git",
    "directory": "packages/viewer"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.mts",
      "import": "./dist/proxy.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@open-wxa/wxa-runner-core": "workspace:*",
    "@open-wxa/wxa-runner-extractor": "workspace:*",
    "esbuild-wasm": "0.28.2",
    "express": "^4.18.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18"
  }
}
