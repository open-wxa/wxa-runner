{
  "name": "@open-wxa/wxa-runner-core",
  "version": "0.6.0",
  "description": "Dev server and browser runtime that run WeChat mini-programs on the official base library",
  "license": "MIT",
  "author": "open-wxa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-wxa/wxa-runner.git",
    "directory": "packages/core"
  },
  "homepage": "https://open-wxa.github.io/wxa-runner/",
  "bugs": {
    "url": "https://github.com/open-wxa/wxa-runner/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.mjs",
      "require": "./dist/setup.js"
    },
    "./test-api": {
      "types": "./dist/test-api.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "setup": [
        "./dist/setup.d.ts"
      ],
      "test-api": [
        "./dist/test-api.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@open-wxa/wxa-runner-compiler": "workspace:*",
    "@open-wxa/wxa-runner-extractor": "workspace:*",
    "chokidar": "^3.5.3",
    "esbuild": "^0.27.0",
    "express": "^4.18.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
