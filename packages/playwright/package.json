{
  "name": "@open-wxa/wxa-runner-playwright",
  "version": "0.2.4",
  "description": "Playwright fixture for wxa-runner: starts the dev server per worker, reads page data and asserts mini-program requests",
  "license": "MIT",
  "author": "open-wxa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-wxa/wxa-runner.git",
    "directory": "packages/playwright"
  },
  "homepage": "https://github.com/open-wxa/wxa-runner#readme",
  "bugs": {
    "url": "https://github.com/open-wxa/wxa-runner/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@open-wxa/wxa-runner-core": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.64.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
